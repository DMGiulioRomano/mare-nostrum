# Output rigenerabile della pipeline
/generated/

# Log dell'engine. Dalla #251 --log-dir e' onorato da entrambi i logger
# (cli.py:600-607), quindi `make brano` scrive sotto generated/brano/logs/;
# './logs' resta il default di chi non passa il flag.
/logs/

# Audio del corpus: versioniamo solo il manifest, non i file
/samples/**
!/samples/README.md
!/samples/.gitkeep

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
.vscode/
# Archivio delle vecchie take (la modalita' non esiste piu': vedi for_each:).
# La riga resta finche' la cartella e' sul disco, per non riempire git status
# di gigabyte di audio.
/takes/

# Artefatti di PGE-ui: audio/grains renderizzati e cache dei peaks
/output/
/cache/

# Il laboratorio rende accanto allo YAML che salva (`render_doc`): un file di
# configs/streams/ ascoltato nel laboratorio lascia li' il suo .aif e i log.
/configs/**/*.aif
/configs/**/logs/
