export GRANSTUDIES_ROOT="$PWD"

# Il motore di PGE-ui e' il submodule pinnato, lo stesso di `make brano`: cosi'
# `cd mare-nostrum && pge-ui` apre il brano senza flag, e editor e Makefile
# girano sullo stesso codice per costruzione (#1). Dichiararlo qui batte anche
# un PGE_ENGINE_ROOT ereditato dalla shell, che verrebbe prima della risalita
# su engine/ (DMGiulioRomano/PGE-ui#165).
export PGE_ENGINE_ROOT="$PWD/engine"
